# Copy this file to .env.local ONLY if you want to run the app on your own
# machine with `npm run dev`. For the real deployment, set these in Vercel
# under Project Settings -> Environment Variables instead - never commit
# real values to git (.env.local is already in .gitignore).

NOTION_TOKEN=ntn_xxx
NOTION_DATABASE_ID=fe867f9d-2c3f-4279-b5d2-d4a5988956fe

# Shared storage for "This Week"'s meal plan + shopping list, so everyone
# who opens the app (e.g. you and your husband) sees the same live plan
# instead of a blank one each time. In Vercel: Project -> Storage ->
# Create Database -> Upstash (Redis) -> connect it to this project - these
# two get filled in for you automatically, you don't need to set them by
# hand except for local development.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: only set these if you rename the columns in your Notion
# "Recipes" database - the defaults already match it as of Sept 2026.
# NOTION_PROP_NAME=Recipe
# NOTION_PROP_TAGS=Tags
# NOTION_PROP_SOURCE=Source
# NOTION_PROP_LINK=Recipe link
# NOTION_PROP_COOK=Cook (mins)
# NOTION_PROP_PREP=Prep (mins)
# NOTION_PROP_SERVES=Serves
# NOTION_PROP_PROTEIN=Protein
